{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitLoop recommendation-service",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      },
      "deviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-device-token"
      }
    }
  },
  "paths": {
    "/api/recommendations/generate": {
      "post": {
        "summary": "Analyse my history and (re)generate recommendations",
        "tags": [
          "recommendation-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/recommendations": {
      "get": {
        "summary": "List my recommendations",
        "tags": [
          "recommendation-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/recommendations/{id}/accept": {
      "post": {
        "summary": "Accept: applies the new schedule to the habit via Activity Service",
        "tags": [
          "recommendation-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/recommendations/{id}/dismiss": {
      "post": {
        "summary": "Dismiss a recommendation",
        "tags": [
          "recommendation-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}