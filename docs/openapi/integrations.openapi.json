{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitLoop integration-service",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      },
      "deviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-device-token"
      }
    }
  },
  "paths": {
    "/api/integrations": {
      "post": {
        "summary": "Connect a wearable / partner app. Returns a device token ONCE",
        "tags": [
          "integration-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "deviceLabel": {
                    "type": "string"
                  }
                },
                "required": [
                  "provider"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "List my connections",
        "tags": [
          "integration-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/integrations/{id}": {
      "delete": {
        "summary": "Disconnect",
        "tags": [
          "integration-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/integrations/events/recent": {
      "get": {
        "summary": "My recent ingested events + processing status",
        "tags": [
          "integration-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/integrations/events": {
      "post": {
        "summary": "Partner/wearable event ingestion (idempotent on eventId)",
        "tags": [
          "integration-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventId": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string (workout|steps|sleep|meditation|custom)"
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string (ISO-8601)"
                  },
                  "activityId": {
                    "type": "string"
                  }
                },
                "required": [
                  "eventId",
                  "type",
                  "value",
                  "timestamp"
                ]
              }
            }
          }
        }
      }
    },
    "/api/integrations/internal/events/{id}/status": {
      "post": {
        "summary": "Called by the Lambda to mark PROCESSED / REJECTED",
        "tags": [
          "integration-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    }
  }
}