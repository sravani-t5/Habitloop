{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitLoop activity-service",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "internalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-key"
      },
      "deviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-device-token"
      }
    }
  },
  "paths": {
    "/api/activities": {
      "post": {
        "summary": "Create a habit",
        "tags": [
          "activity-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "frequencyPerWeek": {
                    "type": "integer"
                  },
                  "scheduledTime": {
                    "type": "string (HH:MM)"
                  }
                },
                "required": [
                  "name",
                  "scheduledTime"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "List my habits (with last 7 days summary)",
        "tags": [
          "activity-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/activities/{id}": {
      "get": {
        "summary": "Get one habit",
        "tags": [
          "activity-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "summary": "Update habit / schedule rules",
        "tags": [
          "activity-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "frequencyPerWeek": {
                    "type": "integer"
                  },
                  "scheduledTime": {
                    "type": "string"
                  }
                },
                "required": []
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a habit",
        "tags": [
          "activity-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/activities/{id}/logs": {
      "post": {
        "summary": "Log done / missed / completed",
        "tags": [
          "activity-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string (done|missed|completed)"
                  },
                  "loggedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "List logs for a habit",
        "tags": [
          "activity-service"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/activities/internal/logs": {
      "post": {
        "summary": "Idempotent log creation used by the event-processor Lambda",
        "tags": [
          "activity-service"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "internalKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tenantId": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "externalEventId": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "loggedAt": {
                    "type": "string"
                  },
                  "activityId": {
                    "type": "string"
                  },
                  "matchKeywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "tenantId",
                  "userId",
                  "externalEventId",
                  "status",
                  "loggedAt"
                ]
              }
            }
          }
        }
      }
    }
  }
}